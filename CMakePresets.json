{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-clang17-base",
      "hidden": true,
      "environment": {
        "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Debug (Ninja)",
      "inherits": "macos-clang17-base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/cmake-build-debug-clang17",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LIMEN_ENGINE_SHARED": "OFF",
        "LIMEN_WARNINGS_AS_ERRORS": "OFF",
        "LIMEN_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "ninja-shared-debug",
      "displayName": "Shared Debug (Ninja)",
      "inherits": "macos-clang17-base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/cmake-build-shared-debug-clang17",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LIMEN_ENGINE_SHARED": "ON",
        "LIMEN_WARNINGS_AS_ERRORS": "OFF",
        "LIMEN_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Release (Ninja)",
      "inherits": "macos-clang17-base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/cmake-build-release-clang17",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LIMEN_ENGINE_SHARED": "OFF",
        "LIMEN_WARNINGS_AS_ERRORS": "OFF",
        "LIMEN_ENABLE_SANITIZERS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug",
      "displayName": "Build Debug",
      "configurePreset": "ninja-debug",
      "targets": [
        "LimenSandBox"
      ]
    },
    {
      "name": "build-shared-debug",
      "displayName": "Build Shared Debug",
      "configurePreset": "ninja-shared-debug",
      "targets": [
        "LimenSandBox"
      ]
    },
    {
      "name": "build-release",
      "displayName": "Build Release",
      "configurePreset": "ninja-release",
      "targets": [
        "LimenSandBox"
      ]
    }
  ]
}
